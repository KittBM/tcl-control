<Window x:Class="TclControlWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCL S45H Control" Height="720" Width="440"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#333" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#333" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <!-- Connection -->
            <GroupBox Header="Connection">
                <StackPanel Margin="6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatus" Text="Not connected" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="TxtAddress" Width="180" Margin="0,0,8,0" />
                        <Button x:Name="BtnConnect" Content="Connect" Click="BtnConnect_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BtnScan" Content="Scan" Click="BtnScan_Click" />
                        <Button x:Name="BtnReconnect" Content="Reconnect" Click="BtnReconnect_Click" />
                        <Button x:Name="BtnRefresh" Content="Refresh status" Click="BtnRefresh_Click" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Volume -->
            <GroupBox Header="Volume">
                <StackPanel Orientation="Horizontal" Margin="6" HorizontalAlignment="Center">
                    <Button x:Name="BtnVolDown" Content="-" Width="40" Click="BtnVolDown_Click" />
                    <TextBlock x:Name="TxtVolume" Text="20" FontSize="20" Width="50" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="BtnVolUp" Content="+" Width="40" Click="BtnVolUp_Click" />
                </StackPanel>
            </GroupBox>

            <!-- Mute / Atmos -->
            <GroupBox Header="Toggles">
                <StackPanel Margin="6">
                    <CheckBox x:Name="ChkMute" Content="Mute" Checked="ChkMute_Changed" Unchecked="ChkMute_Changed" />
                    <CheckBox x:Name="ChkAtmos" Content="Dolby Atmos / DTS:X" Checked="ChkAtmos_Changed" Unchecked="ChkAtmos_Changed" />
                </StackPanel>
            </GroupBox>

            <!-- Source -->
            <GroupBox Header="Source">
                <StackPanel Orientation="Horizontal" Margin="6" HorizontalAlignment="Center">
                    <ToggleButton x:Name="BtnSource1" Content="HDMI" Click="BtnSource1_Click" />
                    <ToggleButton x:Name="BtnSource2" Content="Optical" Click="BtnSource2_Click" />
                    <ToggleButton x:Name="BtnSource3" Content="AUX" Click="BtnSource3_Click" />
                </StackPanel>
            </GroupBox>

            <!-- Sound Mode -->
            <GroupBox Header="Sound Mode">
                <StackPanel Orientation="Horizontal" Margin="6" HorizontalAlignment="Center">
                    <ToggleButton x:Name="BtnMode1" Content="Music" Click="BtnMode1_Click" />
                    <ToggleButton x:Name="BtnMode2" Content="Voice" Click="BtnMode2_Click" />
                    <ToggleButton x:Name="BtnMode3" Content="Movie" Click="BtnMode3_Click" />
                </StackPanel>
            </GroupBox>

            <!-- Bass / Treble -->
            <GroupBox Header="Bass / Treble">
                <StackPanel Margin="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bass" Width="60" VerticalAlignment="Center" />
                        <Slider x:Name="SliderBass" Minimum="-6" Maximum="6" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="SliderBass_ValueChanged" />
                        <TextBlock x:Name="TxtBassValue" Text="0" Width="30" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Treble" Width="60" VerticalAlignment="Center" />
                        <Slider x:Name="SliderTreble" Minimum="-6" Maximum="6" Width="220" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="SliderTreble_ValueChanged" />
                        <TextBlock x:Name="TxtTrebleValue" Text="0" Width="30" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Log -->
            <GroupBox Header="Log">
                <ListBox x:Name="ListLog" Height="180" Background="#151515" Foreground="#CCCCCC" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Window>
