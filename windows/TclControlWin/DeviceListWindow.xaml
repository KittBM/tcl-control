<Window x:Class="TclControlWin.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select soundbar" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="ListDevices" Grid.Row="0" Background="#2A2A2A" Foreground="White"
                  BorderBrush="#444" MouseDoubleClick="ListDevices_MouseDoubleClick" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="BtnCancel_Click" />
            <Button Content="Select" Width="80" Click="BtnSelect_Click" />
        </StackPanel>
    </Grid>
</Window>
